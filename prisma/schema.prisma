// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id         String   @id @default(uuid())
  username   String   @unique 
  profilePic String   
  traders    Trader[]
}

model Trader {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  name           String
  uxAddress      String
  referralCode   String?
  region         String
  xAccountLink   String
  xHandle        String
  xProfilePic    String?
  
  historyData    String   @default("[]") // Personal Volume History
  
  // MANUAL INPUT (Used for Tier)
  expectedVolume Float 
  tier           String

  // REAL DATA (From API)
  realVolume     Float @default(0) 

  // REFERRAL DATA
  referralVolume30d Float @default(0)
  referralHistory   String @default("[]")

  // RELATIONS
  deal           Deal?    // One-to-One Relation

  tags           String   @default("")
  notes          String?
  addedById      String
  addedBy        User     @relation(fields: [addedById], references: [id])
  lastActive     DateTime @default(now()) 
}

// NEW DEAL MODEL
model Deal {
  id              String  @id @default(uuid())
  traderId        String  @unique
  trader          Trader  @relation(fields: [traderId], references: [id], onDelete: Cascade)

  retainerAmount  Float?
  cashbackPercent Float?

  // Commission Structure
  commTier1       Float?
  commTier2       Float?
  commTier3       Float?
  commTier4       Float?
  commTier5       Float?
}